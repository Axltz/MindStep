<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal de MindStep usando MaterialComponents para compatibilidad total con MaterialCardView, MaterialButton y BottomNavigationView -->
    <style name="Theme.MindStep" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/success</item>
        <item name="colorSecondaryVariant">@color/success_light</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>
</resources>
