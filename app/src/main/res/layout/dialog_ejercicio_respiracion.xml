<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_option_unselected"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloEjercicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Respiración Guiada 4-7-8"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Sigue el ritmo en pantalla y relaja tu cuerpo"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Círculo animado de respiración -->
    <FrameLayout
        android:id="@+id/circuloRespiracion"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circle_green">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInstruccionRespiracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inhala"
                android:textColor="@color/success"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSegundosRespiracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4s"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizarEjercicio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#059669"
        android:text="Me siento más tranquilo / Terminar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</LinearLayout>
