<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Header con botón atrás -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBackAsistente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Atrás"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistente de Apoyo Preventivo"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoAsistente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● En línea • TCC y Regulación Emocional"
                android:textColor="@color/success"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Mensajes del Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <!-- Carrusel Horizontal de Respuestas Rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRespiracion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="🌬️ Respiración 4-7-8"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAnsiedad"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="⚡ Siento mucha Ansiedad"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipExamenes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="📚 Sobrecarga de Exámenes"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSueno"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="🌙 No puedo dormir"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipBurnout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="😫 Me siento con Burnout"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Barra de Entrada de Texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etMensajeUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_unselected"
            android:hint="Escribe cómo te sientes..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnEnviarMensaje"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_chat_user"
            android:contentDescription="Enviar mensaje"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/white" />
    </LinearLayout>

</LinearLayout>
